#!/bin/bash

if [[ x$JB_ROOT_PATH != x"" ]]; then
    JBROOT="/var/jb"
else
    JBROOT=""
fi
TYPEX_SHARED_DIR="$JBROOT/Library/TypeX"
mkdir -p "$TYPEX_SHARED_DIR" || true
# Settings runs as mobile and writes the snapshot with an atomic rename, so the
# directory itself (not only shared.plist) must remain writable.
chmod 0777 "$TYPEX_SHARED_DIR"

exit 0
